; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mexarena Junk Test"
config/description="Playground for rapidly iterating on the core tactical experience."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Events="*res://autoload/events.gd"
SceneRouter="*res://autoload/scene_router.gd"
DebugHud="*res://core/debug/sandbox_hud.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[rendering]

environment/defaults/default_clear_color=Color(0.12, 0.13, 0.16, 1)

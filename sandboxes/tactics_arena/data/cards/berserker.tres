[gd_resource type="Resource" script_class="CardData" format=3]

[ext_resource type="Script" path="res://core/cards/card_data.gd" id="1_card_data"]
[ext_resource type="Script" path="res://core/attributes/attribute.gd" id="2_attribute"]
[ext_resource type="Script" path="res://core/attributes/attribute_modifier.gd" id="3_attribute_mo"]

[sub_resource type="Resource" id="Resource_frenzy_mod1"]
script = ExtResource("3_attribute_mo")
target_id = &"speed"
op = 1
amount = 25.0

[sub_resource type="Resource" id="Resource_frenzy_mod0"]
script = ExtResource("3_attribute_mo")
target_id = &"attack"
op = 0
amount = 2.0

[sub_resource type="Resource" id="Resource_hp"]
script = ExtResource("2_attribute")
id = &"hp"
display_name = "HP"
tags = PackedStringArray("stat")
base_value = 9.0
is_pool = true

[sub_resource type="Resource" id="Resource_attack"]
script = ExtResource("2_attribute")
id = &"attack"
display_name = "Attack"
tags = PackedStringArray("stat")
base_value = 3.0

[sub_resource type="Resource" id="Resource_range"]
script = ExtResource("2_attribute")
id = &"range"
display_name = "Range"
tags = PackedStringArray("stat")
base_value = 1.0

[sub_resource type="Resource" id="Resource_movement"]
script = ExtResource("2_attribute")
id = &"movement"
display_name = "Movement"
tags = PackedStringArray("stat")
base_value = 3.0

[sub_resource type="Resource" id="Resource_speed"]
script = ExtResource("2_attribute")
id = &"speed"
display_name = "Speed"
tags = PackedStringArray("stat")
base_value = 12.0

[sub_resource type="Resource" id="Resource_frenzy"]
script = ExtResource("2_attribute")
id = &"frenzy"
display_name = "Frenzy"
description = "+2 attack, +25% speed."
tags = PackedStringArray("buff")
base_value = 0.0
modifiers = Array[ExtResource("3_attribute_mo")]([SubResource("Resource_frenzy_mod0"), SubResource("Resource_frenzy_mod1")])

[resource]
script = ExtResource("1_card_data")
id = &"berserker"
display_name = "Berserker"
description = "Frenzy: +2 attack and +25% speed."
color = Color(0.9, 0.35, 0.35, 1)
attributes = Array[ExtResource("2_attribute")]([SubResource("Resource_hp"), SubResource("Resource_attack"), SubResource("Resource_range"), SubResource("Resource_movement"), SubResource("Resource_speed"), SubResource("Resource_frenzy")])

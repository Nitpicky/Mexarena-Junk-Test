[gd_resource type="Resource" script_class="CardData" format=3]

[ext_resource type="Script" path="res://core/cards/card_data.gd" id="1_card_data"]
[ext_resource type="Script" path="res://core/attributes/attribute.gd" id="2_attribute"]
[ext_resource type="Script" path="res://core/combat/behaviors/heal_over_time_behavior.gd" id="3_heal_over_ti"]
[ext_resource type="Script" path="res://core/attributes/attribute_behavior.gd" id="4_attribute_be"]

[sub_resource type="Resource" id="Resource_regeneration_beh0"]
script = ExtResource("3_heal_over_ti")

[sub_resource type="Resource" id="Resource_hp"]
script = ExtResource("2_attribute")
id = &"hp"
display_name = "HP"
tags = PackedStringArray("stat")
base_value = 30.0
is_pool = true

[sub_resource type="Resource" id="Resource_attack"]
script = ExtResource("2_attribute")
id = &"attack"
display_name = "Attack"
tags = PackedStringArray("stat")
base_value = 4.0

[sub_resource type="Resource" id="Resource_range"]
script = ExtResource("2_attribute")
id = &"range"
display_name = "Range"
tags = PackedStringArray("stat")
base_value = 1.0

[sub_resource type="Resource" id="Resource_movement"]
script = ExtResource("2_attribute")
id = &"movement"
display_name = "Movement"
tags = PackedStringArray("stat")
base_value = 3.0

[sub_resource type="Resource" id="Resource_speed"]
script = ExtResource("2_attribute")
id = &"speed"
display_name = "Speed"
tags = PackedStringArray("stat")
base_value = 10.0

[sub_resource type="Resource" id="Resource_regeneration"]
script = ExtResource("2_attribute")
id = &"regeneration"
display_name = "Regeneration"
description = "Heals 1 HP at the end of each turn."
tags = PackedStringArray("buff")
base_value = 1.0
behaviors = Array[ExtResource("4_attribute_be")]([SubResource("Resource_regeneration_beh0")])

[resource]
script = ExtResource("1_card_data")
id = &"warlord"
display_name = "Warlord"
description = "General. Sturdy melee leader that regenerates."
color = Color(0.85, 0.55, 0.3, 1)
tags = PackedStringArray("general")
attributes = Array[ExtResource("2_attribute")]([SubResource("Resource_hp"), SubResource("Resource_attack"), SubResource("Resource_range"), SubResource("Resource_movement"), SubResource("Resource_speed"), SubResource("Resource_regeneration")])

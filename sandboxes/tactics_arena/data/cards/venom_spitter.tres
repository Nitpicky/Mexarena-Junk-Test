[resource]
script = ExtResource("1_card_data")
id = &"venom_spitter"
display_name = "Venom Spitter"
description = "Its hits poison. Poisons merge into one stronger poison."
color = Color(0.4, 0.85, 0.6, 1)
attributes = Array[ExtResource("2_attribute")]([SubResource("Resource_hp"), SubResource("Resource_attack"), SubResource("Resource_range"), SubResource("Resource_movement"), SubResource("Resource_speed"), SubResource("Resource_venom")])

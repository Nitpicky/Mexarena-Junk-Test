# Normalize text files to LF in the repo (Godot writes LF on every platform).
* text=auto eol=lf

# Godot text formats
*.gd      text eol=lf diff=python
*.tscn    text eol=lf
*.tres    text eol=lf
*.godot   text eol=lf
*.cfg     text eol=lf
*.import  text eol=lf
*.uid     text eol=lf
*.gdshader text eol=lf
*.md      text eol=lf

# Binary assets: never diff or merge.
# If the repo grows heavy, switch these to Git LFS (see README).
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.svg  text eol=lf
*.wav  binary
*.ogg  binary
*.mp3  binary
*.ttf  binary
*.otf  binary
*.woff2 binary
*.glb  binary
*.gltf text eol=lf
*.blend binary
*.fbx  binary
*.obj  text eol=lf
*.res  binary
*.scn  binary
